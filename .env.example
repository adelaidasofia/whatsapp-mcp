# Bridge
WHATSAPP_BRIDGE_PORT=8080
WHATSAPP_BRIDGE_HOST=127.0.0.1
# Port 0 = let the OS pick a free port. The bridge announces it with a
# "BRIDGE_LISTENING port=N" stdout line and a bridge.port file next to the DB.

# Storage
# Defaults resolve under your home directory on every OS
# (macOS/Linux: ~/.claude/whatsapp-mcp/ · Windows: C:\Users\you\.claude\whatsapp-mcp\).
# ${HOME} works in these examples on macOS/Linux; on Windows set absolute paths.
WHATSAPP_DB_PATH=${HOME}/.claude/whatsapp-mcp/store/messages.db
WHATSAPP_MEDIA_PATH=${HOME}/.claude/whatsapp-mcp/media/
WHATSAPP_BACKUP_PATH=${HOME}/.claude/whatsapp-mcp/store/backups/

# Encryption (SQLCipher DB at rest). Key lives in the platform secret store:
# macOS Keychain · Windows Credential Manager · Linux libsecret (secret-tool).
WHATSAPP_ENCRYPT_DB=true
WHATSAPP_KEYCHAIN_SERVICE=whatsapp-mcp
WHATSAPP_KEYCHAIN_ACCOUNT=default
# Explicit key override (64 hex chars = 32 bytes) for headless/CI/custom
# secret managers. When set, the platform secret store is not touched.
# Generate one:  openssl rand -hex 32
WHATSAPP_DB_KEY=

# Vault CRM auto-injection. Absolute path to the CRM folder (one .md per contact).
# Leave empty to disable CRM injection.
# Example: /Users/you/Vault/CRM/
WHATSAPP_VAULT_CRM_PATH=

# Voice-note transcription
# Backends: off (default — zero-config boot), local-cpp (private, needs a
# whisper.cpp model), openai-api (opt-in, sends audio to OpenAI).
# Enabling local-cpp requires WHATSAPP_WHISPER_MODEL_PATH to an existing
# ggml-*.bin — the bridge refuses to boot otherwise (fail-loud by design).
WHATSAPP_WHISPER_BACKEND=off
WHATSAPP_WHISPER_MODEL=large-v3
WHATSAPP_WHISPER_LANGUAGE=es
WHATSAPP_WHISPER_BIN_PATH=
WHATSAPP_WHISPER_MODEL_PATH=
# Only needed when backend=openai-api
WHATSAPP_WHISPER_API_KEY=

# Security
WHATSAPP_SCRUB_PROMPT_INJECTION=true
WHATSAPP_AUDIT_LOG=true
WHATSAPP_AUDIT_LOG_PATH=${HOME}/.claude/whatsapp-mcp/audit.log
WHATSAPP_AUDIT_LOG_RETENTION_DAYS=30

# Webhooks (disabled by default). Set to a local URL to enable.
WHATSAPP_WEBHOOK_URL=

# Feature flags
WHATSAPP_CAPTURE_CALLS=true
WHATSAPP_CAPTURE_REACTIONS=true
WHATSAPP_AUTO_DOWNLOAD_MEDIA=false
